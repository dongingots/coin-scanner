APP_NAME=Bybit Futures Bot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bybit_bot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=360

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

BYBIT_DEFAULT_ENVIRONMENT=testnet
BYBIT_LIVE_TRADING_ENABLED=false
BYBIT_TESTNET_URL=https://api-testnet.bybit.com
BYBIT_MAINNET_URL=https://api.bybit.com
BYBIT_RECV_WINDOW=5000
BYBIT_TIMEOUT=10
BYBIT_CONNECT_TIMEOUT=3
BYBIT_MAX_RETRIES=2
BYBIT_RETRY_DELAY_MS=250
BYBIT_SCANNER_ENVIRONMENT=testnet
SCANNER_CANDLE_HISTORY_LIMIT=400
SCANNER_REQUESTS_PER_SECOND=4

# Exchange account credentials are stored encrypted in the database.
# Add them through the application settings after setup; never put live API
# credentials in this file. Bybit accounts default to testnet.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
